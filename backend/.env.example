NODE_ENV=local
SERVICE_NAME=backend-core-platform-api
INSTANCE_ID=local-api
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/backend_core_platform?schema=platform
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
QUEUE_PREFIX=backend-core-platform
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=var/storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=backend-core-platform
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
OCR_WORKER_CONCURRENCY=2
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
CORS_ORIGIN=http://localhost:5173
COPYRIGHT_RISK_PROVIDER=heuristic
COPYRIGHT_AI_BASE_URL=
COPYRIGHT_AI_API_KEY=
COPYRIGHT_AI_MODEL=qwen3-vl-plus
COPYRIGHT_AI_TIMEOUT_MS=180000
COPYRIGHT_AI_MAX_TOKENS=6000
ANTHROPIC_API_KEY=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BAIDU_OCR_ENDPOINT=https://aip.baidubce.com/rest/2.0/ocr/v1/table
BAIDU_HANDWRITING_OCR_ENDPOINT=https://aip.baidubce.com/rest/2.0/ocr/v1/handwriting
BAIDU_GENERAL_OCR_ENDPOINT=https://aip.baidubce.com/rest/2.0/ocr/v1/general
BAIDU_TOKEN_ENDPOINT=https://aip.baidubce.com/oauth/2.0/token
OCR_MAX_IMAGE_BYTES=10485760
OCR_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/jpg
