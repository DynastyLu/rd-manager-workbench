NODE_ENV=local
SERVICE_NAME=rd-manager-workbench
INSTANCE_ID=local-api
HOST=127.0.0.1
PORT=4311
DATABASE_URL=postgresql://rd_manager_workbench_app@127.0.0.1:5432/rd_manager_workbench?schema=app&connection_limit=5
LOCAL_STORAGE_ROOT=var/storage
# 本地开发占位值，不是真实秘密；生产环境必须替换为至少 32 位的随机高熵值。
JWT_ACCESS_SECRET=development-only-replace-with-a-random-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
JWT_REFRESH_REMEMBER_TTL_DAYS=30
AUTH_COOKIE_NAME=rd_refresh
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:4312,http://localhost:4312
# 默认超级管理员账号。生产环境必须修改 DEFAULT_ADMIN_PASSWORD，不能继续使用默认值。
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=RdManager2026!
# 可选：Office 文件保真预览所用的 soffice 可执行文件绝对路径。
# LIBREOFFICE_BIN=/Applications/LibreOffice.app/Contents/MacOS/soffice
