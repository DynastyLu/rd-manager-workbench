  @@index([applicationCaseId, collectedAt])
  @@map("evidence_records")
  @@schema("app")
}

model EvidenceRecordLink {
  id                       String                  @id @default(cuid())
  evidenceRecordId         String                  @map("evidence_record_id")
  applicationRequirementId String?                 @map("application_requirement_id")
  applicationMaterialId    String?                 @map("application_material_id")
