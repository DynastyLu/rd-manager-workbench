model Role {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  description     String?
  isSystem        Boolean          @default(false) @map("is_system")
  isEnabled       Boolean          @default(true) @map("is_enabled")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  documentRoleShares DocumentRoleShare[]

  @@map("roles")
  @@schema("app")
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  module          String
  resource        String
  action          String
  description     String?
  isSensitive     Boolean          @default(false) @map("is_sensitive")
  rolePermissions RolePermission[]

  @@map("permissions")
  @@schema("app")
}

model UserRole {
  userId           String   @map("user_id")
  roleId           String   @map("role_id")
  assignedByUserId String?  @map("assigned_by_user_id")
  assignedAt       DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy       User?    @relation("UserRoleAssignedBy", fields: [assignedByUserId], references: [id])
  role             Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user             User     @relation("UserRoleUser", fields: [userId], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedByUserId])
  @@map("user_roles")
  @@schema("app")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  dataScope    DataScope  @default(SELF) @map("data_scope")
  scopeConfig  Json?      @map("scope_config")
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
  @@schema("app")
}

model AuthSession {
  id                 String       @id @default(cuid())
  userId             String       @map("user_id")
  refreshTokenHash   String       @unique @map("refresh_token_hash")
  tokenFamilyId      String       @map("token_family_id")
  rotatedToSessionId String?      @unique @map("rotated_to_session_id")
  deviceName         String?      @map("device_name")
  userAgent          String?      @map("user_agent")
  ipAddress          String?      @map("ip_address")
  expiresAt          DateTime     @map("expires_at") @db.Timestamptz(6)
  lastUsedAt         DateTime?    @map("last_used_at") @db.Timestamptz(6)
  revokedAt          DateTime?    @map("revoked_at") @db.Timestamptz(6)
  revokeReason       String?      @map("revoke_reason")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  rotatedToSession   AuthSession? @relation("AuthSessionRotation", fields: [rotatedToSessionId], references: [id])
  rotatedFromSession AuthSession? @relation("AuthSessionRotation")
  user               User         @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@index([tokenFamilyId])
  @@index([revokedAt])
  @@map("auth_sessions")
  @@schema("app")
}

model LoginAudit {
