model Meeting {
  id                String           @id @default(cuid())
  projectId         String?          @map("project_id")
  minutesDocumentId String?          @unique @map("minutes_document_id")
  title             String
  scheduledAt       DateTime         @map("scheduled_at") @db.Timestamptz(6)
  heldAt            DateTime?        @map("held_at") @db.Timestamptz(6)
  status            MeetingStatus    @default(PLANNED)
  agenda            String?
  minutes           String?
  participantNames  String[]         @default([]) @map("participant_names")
  archivedAt        DateTime?        @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  project           Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  minutesDocument   ContentDocument? @relation("MeetingMinutesDocument", fields: [minutesDocumentId], references: [id], onDelete: SetNull)
  documents         ContentDocument[] @relation("MeetingDocuments")
  fileAssets        FileAsset[]
  actions           MeetingAction[]
  agendaItems       MeetingAgendaItem[]
  decisions         Decision[]

  @@index([projectId, archivedAt, status])
  @@index([scheduledAt])
  @@map("meetings")
  @@schema("app")
}

model CalendarEvent {
  id         String            @id @default(cuid())
  projectId  String?           @map("project_id")
  title      String
  startAt    DateTime          @map("start_at") @db.Timestamptz(6)
  endAt      DateTime          @map("end_at") @db.Timestamptz(6)
  allDay     Boolean           @default(false) @map("all_day")
  location   String?
  link       String?
  notes      String?
  type       CalendarEventType @default(FOCUS)
  archivedAt DateTime?         @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  project    Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([startAt, endAt])
  @@index([projectId, archivedAt, startAt])
  @@map("calendar_events")
  @@schema("app")
}

model MeetingAgendaItem {
  id          String    @id @default(cuid())
  meetingId   String    @map("meeting_id")
  title       String
  description String?
  sequence    Int       @default(0)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  meeting     Meeting   @relation(fields: [meetingId], references: [id], onDelete: Restrict)

  @@index([meetingId, archivedAt, sequence])
  @@map("meeting_agenda_items")
  @@schema("app")
}

model MeetingAction {
  id          String              @id @default(cuid())
  meetingId   String              @map("meeting_id")
  title       String
  description String?
  ownerName   String?             @map("owner_name")
  dueAt       DateTime?           @map("due_at") @db.Timestamptz(6)
  status      MeetingActionStatus @default(OPEN)
  taskId      String?             @unique @map("task_id")
  archivedAt  DateTime?           @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  meeting     Meeting             @relation(fields: [meetingId], references: [id], onDelete: Restrict)

  @@index([meetingId, archivedAt, dueAt])
  @@map("meeting_actions")
  @@schema("app")
}

model DataWorkspace {
  id          String      @id @default(cuid())
  name        String
  description String?
  sequence    Int         @default(0)
  archivedAt  DateTime?   @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  tables      DataTable[]

  @@index([archivedAt, sequence, name])
  @@map("data_workspaces")
  @@schema("app")
}

model DataTable {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  name        String
  description String?
  source      DataTableSource @default(CUSTOM)
  presetKey   String?         @unique @map("preset_key")
  icon        String?
  sequence    Int             @default(0)
  archivedAt  DateTime?       @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   DataWorkspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  fields      DataField[]
  records     DataRecord[]
  views       DataView[]

  @@index([workspaceId, archivedAt, sequence])
  @@map("data_tables")
  @@schema("app")
}

model DataField {
  id         String        @id @default(cuid())
  tableId    String        @map("table_id")
  key        String
  name       String
  type       DataFieldType
  config     Json          @default("{}")
  isPrimary  Boolean       @default(false) @map("is_primary")
  isRequired Boolean       @default(false) @map("is_required")
  sequence   Int           @default(0)
  archivedAt DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  table      DataTable     @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, key])
  @@index([tableId, archivedAt, sequence])
  @@map("data_fields")
  @@schema("app")
}

model DataRecord {
  id        String    @id @default(cuid())
  tableId   String    @map("table_id")
  values    Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  table     DataTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId, updatedAt])
  @@map("data_records")
  @@schema("app")
}

model DataView {
  id        String       @id @default(cuid())
  tableId   String       @map("table_id")
  name      String
  type      DataViewType @default(GRID)
  config    Json         @default("{}")
  isDefault Boolean      @default(false) @map("is_default")
  sequence  Int          @default(0)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  table     DataTable    @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId, sequence])
  @@map("data_views")
  @@schema("app")
}
