generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app"]
}

model AppMetadata {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_metadata")
  @@schema("app")
}

model Project {
  id                         String                     @id @default(cuid())
  code                       String                     @unique
  name                       String
  type                       String?
  researchDirection          String?                    @map("research_direction")
  objective                  String?
  expectedOutcome            String?                    @map("expected_outcome")
  leadName                   String?                    @map("lead_name")
  participantNames           String[]                   @default([]) @map("participant_names")
  plannedStartAt             DateTime?                  @map("planned_start_at") @db.Timestamptz(6)
  plannedEndAt               DateTime?                  @map("planned_end_at") @db.Timestamptz(6)
  actualStartAt              DateTime?                  @map("actual_start_at") @db.Timestamptz(6)
  actualEndAt                DateTime?                  @map("actual_end_at") @db.Timestamptz(6)
  phase                      ProjectPhase               @default(PLANNING)
  status                     ProjectStatus              @default(DRAFT)
  archivedAt                 DateTime?                  @map("archived_at") @db.Timestamptz(6)
  createdByUserId            String?                    @map("created_by_user_id")
  updatedByUserId            String?                    @map("updated_by_user_id")
  ownerUserId                String?                    @map("owner_user_id")
  visibility                 BusinessVisibility         @default(PRIVATE)
  createdAt                  DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  healthOverride             ProjectHealth?             @map("health_override")
  workItemViewConfig         Json?                      @map("work_item_view_config")
  weightMode                 ProjectWeightMode          @default(EQUAL) @map("weight_mode")
  ActivityRecord           ActivityRecord[]
  applicationCases           ApplicationCase[]
  calendarEvents             CalendarEvent[]
  communications             CommunicationRecord[]
  contentDocuments           ContentDocument[]
  decisions                  Decision[]
  employeeWeekPlanItems      EmployeeWeekPlanItem[]
  resolvedEmployeeImportRows EmployeeWorkImportRow[]
  progressDrafts             ProjectProgressDraft[]
  employeeWorkItems          EmployeeWorkItem[]
  fileAssets                 FileAsset[]
  intelligenceItems          IntelligenceItemProject[]
  intelligenceTopics         IntelligenceTopicProject[]
  issues                     Issue[]
  meetings                   Meeting[]
  milestones                 Milestone[]
  nonProjectRdItems          NonProjectRdItem[]
  partnerProjects            PartnerProject[]
  progressReports            ProgressReport[]
  healthSnapshots            ProjectHealthSnapshot[]
  ProjectPlanBaseline     ProjectPlanBaseline[]
  ProjectPlanChange       ProjectPlanChange[]
  resourceLoadEntries        ResourceLoadEntry[]
  risks                      Risk[]
  tasks                      WorkTask[]

  @@index([status, archivedAt])
  @@index([plannedEndAt])
  createdBy                  User?                      @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy                  User?                      @relation("ProjectUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  owner                      User?                      @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  members                    ProjectMember[]
  @@index([ownerUserId])
  @@map("projects")
  @@schema("app")
}

model Milestone {
  id                      String           @id @default(cuid())
  projectId               String           @map("project_id")
  name                    String
  plannedAt               DateTime?        @map("planned_at") @db.Timestamptz(6)
  actualAt                DateTime?        @map("actual_at") @db.Timestamptz(6)
  ownerName               String?          @map("owner_name")
  isCritical              Boolean          @default(false) @map("is_critical")
  status                  MilestoneStatus  @default(PENDING)
  createdByUserId         String?          @map("created_by_user_id")
  updatedByUserId         String?          @map("updated_by_user_id")
  ownerUserId             String?          @map("owner_user_id")
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  plannedStartAt          DateTime?        @map("planned_start_at") @db.Timestamptz(6)
  plannedEndAt            DateTime?        @map("planned_end_at") @db.Timestamptz(6)
  weightPercent           Decimal?         @map("weight_percent") @db.Decimal(5, 2)
  manualCompletionPercent Decimal?         @map("manual_completion_percent") @db.Decimal(5, 2)
  decisions               Decision[]
  issues                  Issue[]
  project                 Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  progressReports         ProgressReport[]
  risks                   Risk[]
  tasks                   WorkTask[]

  @@index([projectId, plannedAt])
  @@index([plannedAt])
  @@index([projectId, plannedStartAt, plannedEndAt])
  createdBy               User?            @relation("MilestoneCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy               User?            @relation("MilestoneUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  owner                   User?            @relation("MilestoneOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  @@map("milestones")
  @@schema("app")
}

model WorkTask {
  id                         String                  @id @default(cuid())
  projectId                  String?                 @map("project_id")
  milestoneId                String?                 @map("milestone_id")
  parentId                   String?                 @map("parent_id")
  title                      String
  description                String?
  assigneeName               String?                 @map("assignee_name")
  collaboratorNames          String[]                @default([]) @map("collaborator_names")
  priority                   TaskPriority            @default(MEDIUM)
  status                     TaskStatus              @default(TODO)
  dueAt                      DateTime?               @map("due_at") @db.Timestamptz(6)
  completedAt                DateTime?               @map("completed_at") @db.Timestamptz(6)
  sourceType                 String?                 @map("source_type")
  sourceId                   String?                 @map("source_id")
  archivedAt                 DateTime?               @map("archived_at") @db.Timestamptz(6)
  createdByUserId            String?                 @map("created_by_user_id")
  updatedByUserId            String?                 @map("updated_by_user_id")
  ownerUserId                String?                 @map("owner_user_id")
  assigneeUserId             String?                 @map("assignee_user_id")
  createdAt                  DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  completionPercent          Int                     @default(0) @map("completion_percent")
  code                       String                  @unique @default(dbgenerated("generate_task_code()"))
  communicationRecord        CommunicationRecord?
  decisions                  Decision[]
  employeeWeekPlanItems      EmployeeWeekPlanItem[]
  resolvedEmployeeImportRows EmployeeWorkImportRow[]
  employeeWorkItems          EmployeeWorkItem[]
  issues                     Issue[]
  meeting_actions            MeetingAction?
  nonProjectRdItem           NonProjectRdItem?
  progressReports            ProgressReport[]
  resourceLoadEntries        ResourceLoadEntry[]
  risks                      Risk[]
  dependents                 TaskDependency[]        @relation("DependencyDependsOn")
  dependencies               TaskDependency[]        @relation("DependencyTask")
  later                      TaskLater?
  reminder                   TaskReminder?
  milestone                  Milestone?              @relation(fields: [milestoneId], references: [id])
  parent                     WorkTask?               @relation("TaskHierarchy", fields: [parentId], references: [id])
  children                   WorkTask[]              @relation("TaskHierarchy")
  project                    Project?                @relation(fields: [projectId], references: [id])

  @@index([projectId, status, dueAt])
  @@index([milestoneId])
  @@index([parentId])
  @@index([archivedAt, dueAt])
  @@index([assigneeName, archivedAt, dueAt])
  createdBy                  User?                   @relation("WorkTaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy                  User?                   @relation("WorkTaskUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  owner                      User?                   @relation("WorkTaskOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  assignee                   User?                   @relation("WorkTaskAssignee", fields: [assigneeUserId], references: [id], onDelete: Restrict)
  participants               WorkTaskParticipant[]
  @@index([ownerUserId])
  @@index([assigneeUserId])
  @@map("tasks")
  @@schema("app")
}

model TaskReminder {
  id          String    @id @default(cuid())
  taskId      String    @unique @map("task_id")
  remindAt    DateTime  @map("remind_at") @db.Timestamptz(6)
  dismissedAt DateTime? @map("dismissed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  task        WorkTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([remindAt, dismissedAt])
  @@map("task_reminders")
  @@schema("app")
}

model TaskLater {
  id            String   @id @default(cuid())
  taskId        String   @unique @map("task_id")
  deferredUntil DateTime @map("deferred_until") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  task          WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([deferredUntil])
  @@map("task_laters")
  @@schema("app")
}

model ReminderRule {
  id            String             @id @default(cuid())
  sourceType    ReminderSourceType @map("source_type")
  sourceId      String             @map("source_id")
  remindAt      DateTime           @map("remind_at") @db.Timestamptz(6)
  archivedAt    DateTime?          @map("archived_at") @db.Timestamptz(6)
  createdByUserId String?            @map("created_by_user_id")
  ownerUserId   String?            @map("owner_user_id")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  channels      ReminderChannel[]  @default([IN_APP])
  important     Boolean            @default(false)
  notification  Notification?
  smsDeliveries SmsDelivery[]

  @@unique([sourceType, sourceId, remindAt])
  @@index([archivedAt, remindAt])
  createdBy     User?              @relation("ReminderRuleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  owner         User?              @relation("ReminderRuleOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  @@map("reminder_rules")
  @@schema("app")
}

model Notification {
  id             String             @id @default(cuid())
  reminderRuleId String             @unique @map("reminder_rule_id")
  title          String
  body           String
  status         NotificationStatus @default(UNREAD)
  sourceType     ReminderSourceType @map("source_type")
  sourceId       String             @map("source_id")
  sourcePath     String             @map("source_path")
  scheduledFor   DateTime           @map("scheduled_for") @db.Timestamptz(6)
  triggeredAt    DateTime           @map("triggered_at") @db.Timestamptz(6)
  readAt         DateTime?          @map("read_at") @db.Timestamptz(6)
  dismissedAt    DateTime?          @map("dismissed_at") @db.Timestamptz(6)
  snoozedUntil   DateTime?          @map("snoozed_until") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  reminderRule   ReminderRule       @relation(fields: [reminderRuleId], references: [id])
  smsDeliveries  SmsDelivery[]

  @@unique([sourceType, sourceId, scheduledFor])
  @@index([status, triggeredAt])
  @@index([status, snoozedUntil])
  @@map("notifications")
  @@schema("app")
}

model KnowledgeSpace {
  id          String            @id @default(cuid())
  name        String
  description String?
  sequence    Int               @default(0)
  archivedAt  DateTime?         @map("archived_at") @db.Timestamptz(6)
  createdByUserId String?         @map("created_by_user_id")
  updatedByUserId String?         @map("updated_by_user_id")
  ownerUserId String?             @map("owner_user_id")
  visibility  BusinessVisibility  @default(PRIVATE)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  documents   ContentDocument[]
  watches     FolderWatch[]

  @@index([archivedAt, sequence, name])
  members     KnowledgeSpaceMember[]
  createdBy   User?             @relation("KnowledgeSpaceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy   User?             @relation("KnowledgeSpaceUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  owner       User?             @relation("KnowledgeSpaceOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  @@map("knowledge_spaces")
  @@schema("app")
}

model ContentDocument {
  id                String                    @id @default(cuid())
  type              ContentDocumentType
  title             String
  content           Json                      @default("{}")
  plainText         String                    @default("") @map("plain_text")
  tags              String[]                  @default([])
  isFavorite        Boolean                   @default(false) @map("is_favorite")
  spaceId           String?                   @map("space_id")
  parentId          String?                   @map("parent_id")
  projectId         String?                   @map("project_id")
  meetingId         String?                   @map("meeting_id")
  status            ContentStatus             @default(ACTIVE)
  trashedAt         DateTime?                 @map("trashed_at") @db.Timestamptz(6)
  createdByUserId   String?                   @map("created_by_user_id")
  updatedByUserId   String?                   @map("updated_by_user_id")
  ownerUserId       String?                   @map("owner_user_id")
  visibility        BusinessVisibility        @default(PRIVATE)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  sourceKind        KnowledgeSourceKind       @default(LEGACY) @map("source_kind")
  originalName      String?                   @map("original_name")
  mimeType          String?                   @map("mime_type")
  fileSize          Int?                      @map("file_size")
  sourceSha256      String?                   @map("source_sha256")
  sourceModifiedAt  DateTime?                 @map("source_modified_at") @db.Timestamptz(6)
  previewStatus     KnowledgeProcessingStatus @default(PENDING) @map("preview_status")
  previewStorageKey String?                   @map("preview_storage_key")
  previewMimeType   String?                   @map("preview_mime_type")
  indexStatus       KnowledgeProcessingStatus @default(PENDING) @map("index_status")
  processingError   String?                   @map("processing_error")
  indexedAt         DateTime?                 @map("indexed_at") @db.Timestamptz(6)
  meeting           Meeting?                  @relation("MeetingDocuments", fields: [meetingId], references: [id])
  parent            ContentDocument?          @relation("ContentDocumentHierarchy", fields: [parentId], references: [id])
  children          ContentDocument[]         @relation("ContentDocumentHierarchy")
  project           Project?                  @relation(fields: [projectId], references: [id])
  space             KnowledgeSpace?           @relation(fields: [spaceId], references: [id])
  chunks            DocumentChunk[]
  versions          DocumentVersion[]
  fileAssets        FileAsset[]
  folderFiles       FolderFile[]
  minutesForMeeting Meeting?                  @relation("MeetingMinutesDocument")

  @@index([status, updatedAt])
  @@index([type, status, updatedAt])
  @@index([spaceId, parentId, status])
  @@index([projectId, status, updatedAt])
  @@index([meetingId, status, updatedAt])
  @@index([sourceKind, status, updatedAt])
  @@index([previewStatus, indexStatus, status])
  createdBy         User?                     @relation("ContentDocumentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy         User?                     @relation("ContentDocumentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  owner             User?                     @relation("ContentDocumentOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  userShares        DocumentUserShare[]
  roleShares        DocumentRoleShare[]
  @@index([ownerUserId, visibility])
  @@map("content_documents")
  @@schema("app")
}

model DocumentVersion {
  id                    String            @id @default(cuid())
  documentId            String            @map("document_id")
  versionNumber         Int               @map("version_number")
  title                 String
  content               Json
  plainText             String            @map("plain_text")
  tags                  String[]          @default([])
  isFavorite            Boolean           @default(false) @map("is_favorite")
  spaceId               String?           @map("space_id")
  parentId              String?           @map("parent_id")
  projectId             String?           @map("project_id")
  meetingId             String?           @map("meeting_id")
  restoredFromVersionId String?           @map("restored_from_version_id")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  document              ContentDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  restoredFromVersion   DocumentVersion?  @relation("DocumentVersionRestore", fields: [restoredFromVersionId], references: [id])
  restorations          DocumentVersion[] @relation("DocumentVersionRestore")

  @@unique([documentId, versionNumber])
  @@index([documentId, createdAt])
  @@index([restoredFromVersionId])
  @@map("document_versions")
  @@schema("app")
}

model FileAsset {
  id                    String               @id @default(cuid())
  name                  String
  documentId            String?              @map("document_id")
  projectId             String?              @map("project_id")
  meetingId             String?              @map("meeting_id")
  status                FileAssetStatus      @default(ACTIVE)
  trashedAt             DateTime?            @map("trashed_at") @db.Timestamptz(6)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  partnerId             String?              @map("partner_id")
  nonProjectRdItemId    String?              @map("non_project_rd_item_id")
  nonProjectRdOutcomeId String?              @map("non_project_rd_outcome_id")
  document              ContentDocument?     @relation(fields: [documentId], references: [id])
  meeting               Meeting?             @relation(fields: [meetingId], references: [id])
  nonProjectRdItem      NonProjectRdItem?    @relation(fields: [nonProjectRdItemId], references: [id])
  nonProjectRdOutcome   NonProjectRdOutcome? @relation(fields: [nonProjectRdOutcomeId], references: [id])
  partner               Partner?             @relation(fields: [partnerId], references: [id])
  project               Project?             @relation(fields: [projectId], references: [id])
  versions              FileVersion[]

  @@index([documentId, status, updatedAt])
  @@index([projectId, status, updatedAt])
  @@index([meetingId, status, updatedAt])
  @@index([partnerId, status, updatedAt])
  @@index([nonProjectRdItemId, status, updatedAt])
  @@index([nonProjectRdOutcomeId, status, updatedAt])
  @@index([status, updatedAt])
  @@map("file_assets")
  @@schema("app")
}

model FileVersion {
  id            String    @id @default(cuid())
  fileAssetId   String    @map("file_asset_id")
  versionNumber Int       @map("version_number")
  storageKey    String    @unique @map("storage_key")
  originalName  String    @map("original_name")
  mimeType      String    @map("mime_type")
  size          Int
  sha256        String
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  fileAsset     FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  @@unique([fileAssetId, versionNumber])
  @@index([fileAssetId, createdAt])
  @@map("file_versions")
  @@schema("app")
}

model TaskDependency {
  taskId          String   @map("task_id")
  dependsOnTaskId String   @map("depends_on_task_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  dependsOnTask   WorkTask @relation("DependencyDependsOn", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  task            WorkTask @relation("DependencyTask", fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
  @@schema("app")
}

model ProgressReport {
  id                      String                   @id @default(cuid())
  projectId               String                   @map("project_id")
  reportedAt              DateTime                 @map("reported_at") @db.Timestamptz(6)
  summary                 String
  completionPercent       Decimal                  @map("completion_percent") @db.Decimal(5, 2)
  blockers                String?
  createdByUserId   String?                  @map("created_by_user_id")
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  previousPercent         Decimal?                 @map("previous_percent") @db.Decimal(5, 2)
  sourceType              ProgressReportSourceType @default(MANUAL) @map("source_type")
  milestoneId             String?                  @map("milestone_id")
  taskId                  String?                  @map("task_id")
  nextSteps               String?                  @map("next_steps")
  changeSnapshot          Json?                    @map("change_snapshot")
  completedResults        String?                  @map("completed_results")
  milestone               Milestone?               @relation(fields: [milestoneId], references: [id])
  project                 Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task                    WorkTask?                @relation(fields: [taskId], references: [id])

  @@index([projectId, reportedAt])
  @@index([projectId, sourceType, reportedAt])
  @@index([reportedAt])
  createdBy         User?                    @relation("ProgressReportCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  adoptedByDraft    ProjectProgressDraft?
  @@map("progress_reports")
  @@schema("app")
}

model ProjectHealthSnapshot {
  id           String        @id @default(cuid())
  projectId    String        @map("project_id")
  health       ProjectHealth
  reasons      Json
  calculatedAt DateTime      @default(now()) @map("calculated_at") @db.Timestamptz(6)
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, calculatedAt])
  @@map("project_health_snapshots")
  @@schema("app")
}

model WorkflowTemplate {
  id               String                 @id @default(cuid())
  name             String
  description      String?
  category         String?
  version          Int                    @default(1)
  archivedAt       DateTime?              @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  applicationCases ApplicationCase[]
  nodes            WorkflowTemplateNode[]

  @@index([archivedAt, name])
  @@map("workflow_templates")
  @@schema("app")
}

model WorkflowTemplateNode {
  id                       String            @id @default(cuid())
  workflowTemplateId       String            @map("workflow_template_id")
  code                     String
  title                    String
  description              String?
  sequence                 Int
  prerequisiteNodeCodes    String[]          @default([]) @map("prerequisite_node_codes")
  requiredRequirementCodes String[]          @default([]) @map("required_requirement_codes")
  requiredMaterialCodes    String[]          @default([]) @map("required_material_codes")
  isRequired               Boolean           @default(true) @map("is_required")
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  applicationNodes         ApplicationNode[]
  workflowTemplate         WorkflowTemplate  @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)

  @@unique([workflowTemplateId, code])
  @@index([workflowTemplateId, sequence])
  @@map("workflow_template_nodes")
  @@schema("app")
}

model ApplicationCase {
  id                 String                   @id @default(cuid())
  code               String                   @unique
  projectId          String                   @map("project_id")
  workflowTemplateId String                   @map("workflow_template_id")
  title              String
  subjectName        String?                  @map("subject_name")
  region             String?
  organization       String?
  batch              String?
  deadlineAt         DateTime?                @map("deadline_at") @db.Timestamptz(6)
  collaboratorNames  String[]                 @default([]) @map("collaborator_names")
  status             ApplicationCaseStatus    @default(DRAFT)
  archivedAt         DateTime?                @map("archived_at") @db.Timestamptz(6)
  createdByUserId     String?                  @map("created_by_user_id")
  updatedByUserId     String?                  @map("updated_by_user_id")
  ownerUserId         String?                  @map("owner_user_id")
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  project            Project                  @relation(fields: [projectId], references: [id])
  workflowTemplate   WorkflowTemplate         @relation(fields: [workflowTemplateId], references: [id])
  materials          ApplicationMaterial[]
  nodes              ApplicationNode[]
  requirements       ApplicationRequirement[]
  corrections        CorrectionRecord[]
  evidenceRecords    EvidenceRecord[]
