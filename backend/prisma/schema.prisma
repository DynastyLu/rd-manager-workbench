  @@index([applicationRequirementId])
  @@index([applicationMaterialId])
  @@map("evidence_record_links")
  @@schema("app")
}

model CorrectionRecord {
  id                 String                      @id @default(cuid())
  applicationCaseId  String                      @map("application_case_id")
  submissionRecordId String?                     @map("submission_record_id")
  title              String
  details            String?
  dueAt              DateTime?                   @map("due_at") @db.Timestamptz(6)
  status             CorrectionStatus            @default(OPEN)
  resolvedAt         DateTime?                   @map("resolved_at") @db.Timestamptz(6)
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  applicationCase    ApplicationCase             @relation(fields: [applicationCaseId], references: [id], onDelete: Cascade)
  submissionRecord   SubmissionRecord?           @relation(fields: [submissionRecordId], references: [id], onDelete: SetNull)
  materialVersions   CorrectionMaterialVersion[]

  @@index([applicationCaseId, status, dueAt])
  @@index([submissionRecordId])
  @@map("correction_records")
  @@schema("app")
}

model SubmissionRecord {
  id                String                      @id @default(cuid())
  applicationCaseId String                      @map("application_case_id")
  referenceNumber   String?                     @map("reference_number")
  submittedByName   String?                     @map("submitted_by_name")
  submittedAt       DateTime?                   @map("submitted_at") @db.Timestamptz(6)
  status            SubmissionStatus            @default(DRAFT)
  note              String?
  createdAt         DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  applicationCase   ApplicationCase             @relation(fields: [applicationCaseId], references: [id], onDelete: Cascade)
  materialVersions  SubmissionMaterialVersion[]
  corrections       CorrectionRecord[]

  @@index([applicationCaseId, submittedAt])
  @@index([status, submittedAt])
  @@map("submission_records")
  @@schema("app")
}

model CorrectionMaterialVersion {
  correctionRecordId String           @map("correction_record_id")
  materialVersionId  String           @map("material_version_id")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  correctionRecord   CorrectionRecord @relation(fields: [correctionRecordId], references: [id], onDelete: Cascade)
  materialVersion    MaterialVersion  @relation(fields: [materialVersionId], references: [id], onDelete: Restrict)

  @@id([correctionRecordId, materialVersionId])
  @@index([materialVersionId])
  @@map("correction_material_versions")
  @@schema("app")
}

model SubmissionMaterialVersion {
  submissionRecordId String           @map("submission_record_id")
  materialVersionId  String           @map("material_version_id")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  submissionRecord   SubmissionRecord @relation(fields: [submissionRecordId], references: [id], onDelete: Cascade)
  materialVersion    MaterialVersion  @relation(fields: [materialVersionId], references: [id], onDelete: Restrict)

  @@id([submissionRecordId, materialVersionId])
  @@index([materialVersionId])
  @@map("submission_material_versions")
  @@schema("app")
}

model Risk {
  id          String         @id @default(cuid())
  projectId   String?        @map("project_id")
  milestoneId String?        @map("milestone_id")
  taskId      String?        @map("task_id")
  title       String
  description String?
  likelihood  RiskLikelihood
  impact      RiskImpact
  level       RiskLevel
  mitigation  String?
  ownerName   String?        @map("owner_name")
  status      RiskStatus     @default(OPEN)
  closedAt    DateTime?      @map("closed_at") @db.Timestamptz(6)
  archivedAt  DateTime?      @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestone   Milestone?     @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  task        WorkTask?      @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId, archivedAt, status])
  @@index([taskId])
  @@map("risks")
  @@schema("app")
}

