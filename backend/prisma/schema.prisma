generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app"]
}

model AppMetadata {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_metadata")
  @@schema("app")
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED

  @@schema("app")
}

enum ProjectPhase {
  DISCOVERY
  PLANNING
  RESEARCH
  DEVELOPMENT
  VALIDATION
  DELIVERY

  @@schema("app")
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  MISSED

  @@schema("app")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED

  @@schema("app")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@schema("app")
}

enum ProjectHealth {
  GREEN
  YELLOW
  RED

  @@schema("app")
}

enum ApplicationCaseStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  CANCELLED

  @@schema("app")
}

enum ApplicationNodeStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED

  @@schema("app")
}

enum RequirementStatus {
  SATISFIED
  PENDING
  TO_VERIFY
  NOT_APPLICABLE

  @@schema("app")
}

enum MaterialReviewStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED

  @@schema("app")
}

enum CorrectionStatus {
  OPEN
  RESOLVED
  WAIVED

  @@schema("app")
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED

  @@schema("app")
}

enum RiskLikelihood {
  LOW
  MEDIUM
  HIGH
  @@schema("app")
}
enum RiskImpact {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  @@schema("app")
}
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  @@schema("app")
}
enum RiskStatus {
  OPEN
  MITIGATING
  CLOSED
  @@schema("app")
}
enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  @@schema("app")
}
enum DecisionStatus {
  DRAFT
  DECIDED
  SUPERSEDED
  @@schema("app")
}
enum AgreementStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  @@schema("app")
}
enum CommunicationType {
  EMAIL
  PHONE
  MEETING
  CHAT
  VISIT
  OTHER
  @@schema("app")
}
enum MeetingStatus {
  PLANNED
  HELD
  CANCELLED
  @@schema("app")
}
enum MeetingActionStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
  @@schema("app")
}

enum CalendarEventType {
  FOCUS
  INTERVIEW
  REVIEW
  OTHER

  @@schema("app")
}

enum ReminderSourceType {
  TASK
  CALENDAR_EVENT
  MEETING

  @@schema("app")
}

enum NotificationStatus {
  UNREAD
  READ
  DISMISSED
  SNOOZED

  @@schema("app")
}

enum ContentDocumentType {
  DOCUMENT
  KNOWLEDGE_PAGE
  MEETING_MINUTES

  @@schema("app")
}

enum ContentStatus {
  ACTIVE
  TRASHED

  @@schema("app")
}

enum FileAssetStatus {
  ACTIVE
  TRASHED

  @@schema("app")
}

enum DataTableSource {
  CUSTOM
  PROJECTS
  WORK_TASKS
  MEETING_ACTIONS
  DOCUMENTS
  RISKS_DECISIONS

  @@schema("app")
}

enum DataFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  DATETIME
  SINGLE_SELECT
  MULTI_SELECT
  CHECKBOX
  LINK
  ATTACHMENT
  RELATION
  LOOKUP
  ROLLUP
  FORMULA
  CREATED_AT
  UPDATED_AT

  @@schema("app")
}

enum DataViewType {
  GRID
  KANBAN
  CALENDAR
  FORM

  @@schema("app")
}

model Project {
  id                String                  @id @default(cuid())
  code              String                  @unique
  name              String
  type              String?
  researchDirection String?                 @map("research_direction")
  objective         String?
  expectedOutcome   String?                 @map("expected_outcome")
  leadName          String?                 @map("lead_name")
  participantNames  String[]                @default([]) @map("participant_names")
  plannedStartAt    DateTime?               @map("planned_start_at") @db.Timestamptz(6)
  plannedEndAt      DateTime?               @map("planned_end_at") @db.Timestamptz(6)
  actualStartAt     DateTime?               @map("actual_start_at") @db.Timestamptz(6)
  actualEndAt       DateTime?               @map("actual_end_at") @db.Timestamptz(6)
  phase             ProjectPhase            @default(PLANNING)
  status            ProjectStatus           @default(DRAFT)
  archivedAt        DateTime?               @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  milestones        Milestone[]
  tasks             WorkTask[]
  progressReports   ProgressReport[]
  healthSnapshots   ProjectHealthSnapshot[]
  applicationCases  ApplicationCase[]
  risks             Risk[]
  issues            Issue[]
  decisions         Decision[]
  communications    CommunicationRecord[]
  meetings          Meeting[]
  calendarEvents    CalendarEvent[]
  contentDocuments  ContentDocument[]
  fileAssets        FileAsset[]

  @@index([status, archivedAt])
  @@index([plannedEndAt])
  @@map("projects")
  @@schema("app")
}

model Milestone {
  id         String          @id @default(cuid())
  projectId  String          @map("project_id")
  name       String
  plannedAt  DateTime?       @map("planned_at") @db.Timestamptz(6)
  actualAt   DateTime?       @map("actual_at") @db.Timestamptz(6)
  ownerName  String?         @map("owner_name")
  isCritical Boolean         @default(false) @map("is_critical")
  status     MilestoneStatus @default(PENDING)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks      WorkTask[]
  risks      Risk[]
  issues     Issue[]
  decisions  Decision[]

  @@index([projectId, plannedAt])
  @@index([plannedAt])
  @@map("milestones")
  @@schema("app")
}

model WorkTask {
  id                String           @id @default(cuid())
  projectId         String?          @map("project_id")
  milestoneId       String?          @map("milestone_id")
  parentId          String?          @map("parent_id")
  title             String
  description       String?
  assigneeName      String?          @map("assignee_name")
  collaboratorNames String[]         @default([]) @map("collaborator_names")
  priority          TaskPriority     @default(MEDIUM)
  status            TaskStatus       @default(TODO)
  dueAt             DateTime?        @map("due_at") @db.Timestamptz(6)
  completedAt       DateTime?        @map("completed_at") @db.Timestamptz(6)
  sourceType        String?          @map("source_type")
  sourceId          String?          @map("source_id")
  archivedAt        DateTime?        @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  project           Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestone         Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  parent            WorkTask?        @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children          WorkTask[]       @relation("TaskHierarchy")
  dependencies      TaskDependency[] @relation("DependencyTask")
  dependents        TaskDependency[] @relation("DependencyDependsOn")
  risks             Risk[]
  issues            Issue[]
  decisions         Decision[]
  reminder          TaskReminder?
  later             TaskLater?

  @@index([projectId, status, dueAt])
  @@index([milestoneId])
  @@index([parentId])
  @@index([archivedAt, dueAt])
  @@index([assigneeName, archivedAt, dueAt])
  @@map("tasks")
  @@schema("app")
}

model TaskReminder {
  id          String    @id @default(cuid())
  taskId      String    @unique @map("task_id")
  remindAt    DateTime  @map("remind_at") @db.Timestamptz(6)
  dismissedAt DateTime? @map("dismissed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  task        WorkTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([remindAt, dismissedAt])
  @@map("task_reminders")
  @@schema("app")
}

model TaskLater {
  id            String   @id @default(cuid())
  taskId        String   @unique @map("task_id")
  deferredUntil DateTime @map("deferred_until") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  task          WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([deferredUntil])
  @@map("task_laters")
  @@schema("app")
}

model ReminderRule {
  id           String             @id @default(cuid())
  sourceType   ReminderSourceType @map("source_type")
  sourceId     String             @map("source_id")
  remindAt     DateTime           @map("remind_at") @db.Timestamptz(6)
  archivedAt   DateTime?          @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  notification Notification?

  @@unique([sourceType, sourceId, remindAt])
  @@index([archivedAt, remindAt])
  @@map("reminder_rules")
  @@schema("app")
}

model Notification {
  id             String             @id @default(cuid())
  reminderRuleId String             @unique @map("reminder_rule_id")
  title          String
  body           String
  status         NotificationStatus @default(UNREAD)
  sourceType     ReminderSourceType @map("source_type")
  sourceId       String             @map("source_id")
  sourcePath     String             @map("source_path")
  scheduledFor   DateTime           @map("scheduled_for") @db.Timestamptz(6)
  triggeredAt    DateTime           @map("triggered_at") @db.Timestamptz(6)
  readAt         DateTime?          @map("read_at") @db.Timestamptz(6)
  dismissedAt    DateTime?          @map("dismissed_at") @db.Timestamptz(6)
  snoozedUntil   DateTime?          @map("snoozed_until") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  reminderRule   ReminderRule       @relation(fields: [reminderRuleId], references: [id], onDelete: Restrict)

  @@unique([sourceType, sourceId, scheduledFor])
  @@index([status, triggeredAt])
  @@index([status, snoozedUntil])
  @@map("notifications")
  @@schema("app")
}

model KnowledgeSpace {
  id          String            @id @default(cuid())
  name        String
  description String?
  sequence    Int               @default(0)
  archivedAt  DateTime?         @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  documents   ContentDocument[]

  @@index([archivedAt, sequence, name])
  @@map("knowledge_spaces")
  @@schema("app")
}

model ContentDocument {
  id                String              @id @default(cuid())
  type              ContentDocumentType
  title             String
  content           Json                @default("{}")
  plainText         String              @default("") @map("plain_text")
  tags              String[]            @default([])
  isFavorite        Boolean             @default(false) @map("is_favorite")
  spaceId           String?             @map("space_id")
  parentId          String?             @map("parent_id")
  projectId         String?             @map("project_id")
  meetingId         String?             @map("meeting_id")
  status            ContentStatus       @default(ACTIVE)
  trashedAt         DateTime?           @map("trashed_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  space             KnowledgeSpace?     @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  parent            ContentDocument?    @relation("ContentDocumentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children          ContentDocument[]   @relation("ContentDocumentHierarchy")
  project           Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meeting           Meeting?            @relation("MeetingDocuments", fields: [meetingId], references: [id], onDelete: SetNull)
  minutesForMeeting Meeting?            @relation("MeetingMinutesDocument")
  versions          DocumentVersion[]
  fileAssets        FileAsset[]

  @@index([status, updatedAt])
  @@index([type, status, updatedAt])
  @@index([spaceId, parentId, status])
  @@index([projectId, status, updatedAt])
  @@index([meetingId, status, updatedAt])
  @@map("content_documents")
  @@schema("app")
}

model DocumentVersion {
  id                    String            @id @default(cuid())
  documentId            String            @map("document_id")
  versionNumber         Int               @map("version_number")
  title                 String
  content               Json
  plainText             String            @map("plain_text")
  tags                  String[]          @default([])
  isFavorite            Boolean           @default(false) @map("is_favorite")
  spaceId               String?           @map("space_id")
  parentId              String?           @map("parent_id")
  projectId             String?           @map("project_id")
  meetingId             String?           @map("meeting_id")
  restoredFromVersionId String?           @map("restored_from_version_id")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  document              ContentDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  restoredFromVersion   DocumentVersion?  @relation("DocumentVersionRestore", fields: [restoredFromVersionId], references: [id], onDelete: SetNull)
  restorations          DocumentVersion[] @relation("DocumentVersionRestore")

  @@unique([documentId, versionNumber])
  @@index([documentId, createdAt])
  @@index([restoredFromVersionId])
  @@map("document_versions")
  @@schema("app")
}

model FileAsset {
  id         String          @id @default(cuid())
  name       String
  documentId String?         @map("document_id")
  projectId  String?         @map("project_id")
  meetingId  String?         @map("meeting_id")
  status     FileAssetStatus @default(ACTIVE)
  trashedAt  DateTime?       @map("trashed_at") @db.Timestamptz(6)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  document   ContentDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  project    Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meeting    Meeting?         @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  versions   FileVersion[]

  @@index([documentId, status, updatedAt])
  @@index([projectId, status, updatedAt])
  @@index([meetingId, status, updatedAt])
  @@index([status, updatedAt])
  @@map("file_assets")
  @@schema("app")
}

model FileVersion {
  id            String    @id @default(cuid())
  fileAssetId   String    @map("file_asset_id")
  versionNumber Int       @map("version_number")
  storageKey    String    @unique @map("storage_key")
  originalName  String    @map("original_name")
  mimeType      String    @map("mime_type")
  size          Int
  sha256        String
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  fileAsset     FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  @@unique([fileAssetId, versionNumber])
  @@index([fileAssetId, createdAt])
  @@map("file_versions")
  @@schema("app")
}

model TaskDependency {
  taskId          String   @map("task_id")
  dependsOnTaskId String   @map("depends_on_task_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  task            WorkTask @relation("DependencyTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask   WorkTask @relation("DependencyDependsOn", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
  @@schema("app")
}

model ProgressReport {
  id                String   @id @default(cuid())
  projectId         String   @map("project_id")
  reportedAt        DateTime @map("reported_at") @db.Timestamptz(6)
  summary           String
  completionPercent Int      @map("completion_percent")
  blockers          String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, reportedAt])
  @@index([reportedAt])
  @@map("progress_reports")
  @@schema("app")
}

model ProjectHealthSnapshot {
  id           String        @id @default(cuid())
  projectId    String        @map("project_id")
  health       ProjectHealth
  reasons      Json
  calculatedAt DateTime      @default(now()) @map("calculated_at") @db.Timestamptz(6)
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, calculatedAt])
  @@map("project_health_snapshots")
  @@schema("app")
}

model WorkflowTemplate {
  id               String                 @id @default(cuid())
  name             String
  description      String?
  category         String?
  version          Int                    @default(1)
  archivedAt       DateTime?              @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  nodes            WorkflowTemplateNode[]
  applicationCases ApplicationCase[]

  @@index([archivedAt, name])
  @@map("workflow_templates")
  @@schema("app")
}

model WorkflowTemplateNode {
  id                       String            @id @default(cuid())
  workflowTemplateId       String            @map("workflow_template_id")
  code                     String
  title                    String
  description              String?
  sequence                 Int
  prerequisiteNodeCodes    String[]          @default([]) @map("prerequisite_node_codes")
  requiredRequirementCodes String[]          @default([]) @map("required_requirement_codes")
  requiredMaterialCodes    String[]          @default([]) @map("required_material_codes")
  isRequired               Boolean           @default(true) @map("is_required")
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  workflowTemplate         WorkflowTemplate  @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)
  applicationNodes         ApplicationNode[]

  @@unique([workflowTemplateId, code])
  @@index([workflowTemplateId, sequence])
  @@map("workflow_template_nodes")
  @@schema("app")
}

model ApplicationCase {
  id                 String                   @id @default(cuid())
  code               String                   @unique
  projectId          String                   @map("project_id")
  workflowTemplateId String                   @map("workflow_template_id")
  title              String
  subjectName        String?                  @map("subject_name")
  region             String?
  organization       String?
  batch              String?
  deadlineAt         DateTime?                @map("deadline_at") @db.Timestamptz(6)
  collaboratorNames  String[]                 @default([]) @map("collaborator_names")
  status             ApplicationCaseStatus    @default(DRAFT)
  archivedAt         DateTime?                @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  project            Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workflowTemplate   WorkflowTemplate         @relation(fields: [workflowTemplateId], references: [id], onDelete: Restrict)
  nodes              ApplicationNode[]
  requirements       ApplicationRequirement[]
  materials          ApplicationMaterial[]
  evidenceRecords    EvidenceRecord[]
  corrections        CorrectionRecord[]
  submissions        SubmissionRecord[]

  @@index([projectId, archivedAt])
  @@index([workflowTemplateId, archivedAt])
  @@index([status, deadlineAt])
  @@map("application_cases")
  @@schema("app")
}

model ApplicationNode {
  id                       String                   @id @default(cuid())
  applicationCaseId        String                   @map("application_case_id")
  workflowTemplateNodeId   String?                  @map("workflow_template_node_id")
  code                     String
  title                    String
  description              String?
  sequence                 Int
  prerequisiteNodeCodes    String[]                 @default([]) @map("prerequisite_node_codes")
  requiredRequirementCodes String[]                 @default([]) @map("required_requirement_codes")
  requiredMaterialCodes    String[]                 @default([]) @map("required_material_codes")
  snapshot                 Json
  status                   ApplicationNodeStatus    @default(PENDING)
  completedAt              DateTime?                @map("completed_at") @db.Timestamptz(6)
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  applicationCase          ApplicationCase          @relation(fields: [applicationCaseId], references: [id], onDelete: Cascade)
  workflowTemplateNode     WorkflowTemplateNode?    @relation(fields: [workflowTemplateNodeId], references: [id], onDelete: SetNull)
  requirements             ApplicationRequirement[]
  materials                ApplicationMaterial[]

  @@unique([applicationCaseId, code])
  @@index([applicationCaseId, sequence])
  @@index([workflowTemplateNodeId])
  @@map("application_nodes")
  @@schema("app")
}

model ApplicationRequirement {
  id                String               @id @default(cuid())
  applicationCaseId String               @map("application_case_id")
  applicationNodeId String?              @map("application_node_id")
  code              String
  title             String
  description       String?
  isRequired        Boolean              @default(true) @map("is_required")
  status            RequirementStatus    @default(PENDING)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  applicationCase   ApplicationCase      @relation(fields: [applicationCaseId], references: [id], onDelete: Cascade)
  applicationNode   ApplicationNode?     @relation(fields: [applicationNodeId], references: [id], onDelete: SetNull)
  evidenceLinks     EvidenceRecordLink[]

  @@unique([applicationCaseId, code])
  @@index([applicationCaseId, status])
  @@index([applicationNodeId])
  @@map("application_requirements")
  @@schema("app")
}

model ApplicationMaterial {
  id                String               @id @default(cuid())
  applicationCaseId String               @map("application_case_id")
  applicationNodeId String?              @map("application_node_id")
  code              String
  title             String
  category          String?
  isRequired        Boolean              @default(true) @map("is_required")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  applicationCase   ApplicationCase      @relation(fields: [applicationCaseId], references: [id], onDelete: Cascade)
  applicationNode   ApplicationNode?     @relation(fields: [applicationNodeId], references: [id], onDelete: SetNull)
  versions          MaterialVersion[]
  evidenceLinks     EvidenceRecordLink[]

  @@unique([applicationCaseId, code])
  @@index([applicationCaseId, isRequired])
  @@index([applicationNodeId])
  @@map("application_materials")
  @@schema("app")
}

model MaterialVersion {
  id                    String                      @id @default(cuid())
  applicationMaterialId String                      @map("application_material_id")
  versionNumber         Int                         @map("version_number")
  fileName              String                      @map("file_name")
  storageKey            String?                     @map("storage_key")
  checksum              String?
  fileSize              Int?                        @map("file_size")
  note                  String?
  reviewStatus          MaterialReviewStatus        @default(DRAFT) @map("review_status")
  isFinal               Boolean                     @default(false) @map("is_final")
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  applicationMaterial   ApplicationMaterial         @relation(fields: [applicationMaterialId], references: [id], onDelete: Cascade)
  correctionLinks       CorrectionMaterialVersion[]
  submissionLinks       SubmissionMaterialVersion[]

  @@unique([applicationMaterialId, versionNumber])
  @@index([applicationMaterialId, createdAt])
  @@map("material_versions")
  @@schema("app")
}

model EvidenceRecord {
  id                String               @id @default(cuid())
  applicationCaseId String               @map("application_case_id")
  title             String
  description       String?
  sourceUri         String?              @map("source_uri")
  collectedAt       DateTime?            @map("collected_at") @db.Timestamptz(6)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
