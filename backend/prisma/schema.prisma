  @@unique([baselineId, milestoneId])
  @@index([milestoneId])
  @@map("project_plan_milestone_snapshots")
  @@schema("app")
}

model ProjectPlanTaskSnapshot {
  id            String              @id @default(cuid())
  baselineId    String              @map("baseline_id")
  taskId        String              @map("task_id")
  milestoneId   String?             @map("milestone_id")
  title         String
  status        TaskStatus
  dueAt         DateTime?           @map("due_at") @db.Timestamptz(6)
  dependencyIds String[]            @default([]) @map("dependency_ids")
  isCritical    Boolean             @default(false) @map("is_critical")
  baseline      ProjectPlanBaseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)

  @@unique([baselineId, taskId])
  @@index([taskId])
  @@map("project_plan_task_snapshots")
  @@schema("app")
}

model ProjectProgressDraft {
  id                 String                     @id @default(cuid())
  projectId          String                     @map("project_id")
  sourceBatchId      String                     @map("source_batch_id")
  sourceVersion      Int                        @map("source_version")
  periodStartAt      DateTime                   @map("period_start_at") @db.Date
  periodEndAt        DateTime                   @map("period_end_at") @db.Date
  contentFingerprint String                     @map("content_fingerprint")
  content            Json
  summary            String
  completedResults   String?                    @map("completed_results")
  nextSteps          String?                    @map("next_steps")
  blockers           String?
  riskSummary        String?                    @map("risk_summary")
  hoursSummary       String?                    @map("hours_summary")
  unlinkedRowCount   Int                        @default(0) @map("unlinked_row_count")
  status             ProjectProgressDraftStatus @default(PENDING)
  adoptedReportId    String?                    @unique @map("adopted_report_id")
  adoptedAt          DateTime?                  @map("adopted_at") @db.Timestamptz(6)
  ignoredAt          DateTime?                  @map("ignored_at") @db.Timestamptz(6)
  invalidatedAt      DateTime?                  @map("invalidated_at") @db.Timestamptz(6)
  invalidationReason String?                    @map("invalidation_reason")
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  adoptedReport      ProgressReport?            @relation(fields: [adoptedReportId], references: [id], onDelete: SetNull)
  project            Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceBatch        EmployeeWorkImportBatch    @relation(fields: [sourceBatchId], references: [id], onDelete: Restrict)

  @@unique([projectId, sourceBatchId, contentFingerprint])
  @@index([projectId, status, periodStartAt])
  @@index([sourceBatchId, status])
  @@map("project_progress_drafts")
  @@schema("app")
}

