{
  "name": "treasure-box",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build && pnpm build:info && node scripts/verify-relative-build.mjs",
    "build:info": "node scripts/write-build-info.mjs dist",
    "check": "pnpm lint && pnpm typecheck && pnpm typecheck:contracts && pnpm test && pnpm build && pnpm build-storybook",
    "ci": "pnpm check",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:contracts": "tsc --noEmit -p src/modules/workbench/api/__tests__/tsconfig.contracts.json",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint:fix": "eslint src/ --fix && prettier --write src/",
    "analyze": "vite-bundle-visualizer --output stats.html --open false",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@douyinfe/semi-icons": "^2.101.0",
    "@douyinfe/semi-ui": "^2.101.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@fullcalendar/core": "6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@hookform/resolvers": "^5.2.2",
    "@sentry/react": "^10.46.0",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/extension-task-item": "^3.28.0",
    "@tiptap/extension-task-list": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx-preview": "0.4.0",
    "echarts": "^6.1.0",
    "framer-motion": "^11.18.2",
    "i18next": "^25.10.9",
    "lucide-react": "^1.7.0",
    "mammoth": "^1.12.0",
    "ogl": "^1.0.11",
    "pdf-parse": "^2.4.5",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "react-i18next": "^16.6.6",
    "react-router-dom": "^7.13.1",
    "shadcn": "^4.1.0",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-essentials": "^8",
    "@storybook/blocks": "^8",
    "@storybook/react": "^8",
    "@storybook/react-vite": "^8",
    "@storybook/test": "^8.6.18",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query-devtools": "^5.95.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "less": "^4.6.4",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "storybook": "^8",
    "tailwindcss": "^4.2.2",
    "typescript": "5",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.1",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^4.1.9"
  }
}
