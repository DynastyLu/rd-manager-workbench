{
  "name": "@rd-manager/backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "pnpm prisma:generate",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && nest build",
    "lint": "eslint src test",
    "pretypecheck": "pnpm prisma:generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest:unit": "pnpm prisma:generate",
    "test:unit": "jest --config test/jest-unit.config.cjs",
    "pretest:e2e": "pnpm prisma:generate",
    "test:e2e": "jest --config test/jest-e2e.config.cjs",
    "pretest:integration": "pnpm prisma:generate",
    "test:integration": "jest --config test/jest-integration.config.cjs --runInBand",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "db:bootstrap": "tsx src/commands/bootstrap-database.ts",
    "prisma:generate": "node scripts/generate-prisma-client.cjs --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "10.4.8",
    "@nestjs/config": "3.2.3",
    "@nestjs/core": "10.4.8",
    "@nestjs/platform-express": "10.4.8",
    "@prisma/client": "6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "express": "4.22.1",
    "pg": "8.22.0",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.8",
    "@nestjs/testing": "10.4.8",
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.3",
    "@types/pg": "8.20.0",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "tsx": "4.23.1"
  }
}
